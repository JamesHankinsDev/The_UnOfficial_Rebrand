# Firebase Admin service account credentials.
# Mirror the values set for the Next.js frontend; can be rotated to a
# dedicated service account later for least-privilege separation.
FIREBASE_ADMIN_PROJECT_ID=the-unofficial-758da
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# BallDontLie API key (same value as the Next.js side).
BALLDONTLIE_API_KEY=

# Optional: set to "1" to run a single ingest cycle and exit. Useful for
# local verification or one-off backfills. Omit in production.
# INGEST_ONCE=1
